{
  "$schema": "https://github.com/oxc-project/oxc/raw/refs/heads/main/npm/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "import",
    "jsx-a11y",
    "oxc",
    "promise",
    "react",
    "react-perf",
    "typescript",
    "unicorn"
  ],
  "overrides": [
    {
      "files": ["src/graph.ts", "src/assistant/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-*",
                  "react/*",
                  "@mui/*",
                  "@emotion/*",
                  "@xyflow/*",
                  "zustand",
                  "zustand/*",
                  "zundo",
                  "@/*",
                  "!@/graph.js",
                  "!@/assistant/*"
                ],
                "message": "The graph model and the assistant run outside the editor, e.g. in MCP servers."
              }
            ]
          }
        ]
      }
    }
  ]
}
